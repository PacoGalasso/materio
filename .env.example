# MATIÈRE — server configuration
# Copy this file to .env and fill in real values. Never commit a real .env file.

# PostgreSQL connection string. Local dev: `docker compose up -d db`, then use the URL below.
# Host port 55432 (not the default 5432) to avoid clashing with any local Postgres install.
DATABASE_URL=postgres://matiere:matiere@localhost:55432/matiere_dev

# Used by `npm test` (Vitest) and `npm run test:e2e` (Playwright) only — separate databases
# on the same local Postgres server so tests never touch development data.
TEST_DATABASE_URL=postgres://matiere:matiere@localhost:55432/matiere_test
E2E_DATABASE_URL=postgres://matiere:matiere@localhost:55432/matiere_e2e

# Session/token signing secret for Better Auth. Generate a real one for every environment,
# at least 32 random characters, e.g.: openssl rand -base64 32
# Never reuse the same secret across development, test, and production.
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret

# Public origin of the app (used to build absolute auth URLs and validate request origins).
BETTER_AUTH_URL=http://localhost:3000

# development | test | production. Controls cookie Secure flag, demo-reset availability, etc.
NODE_ENV=development
